{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "cli:default",
    "fs:default",
    {"identifier": "fs:allow-exists", "allow": [{"path": "$APPDATA/cutscenes"}, {"path": "$APPDATA/cutscenes/**"}]},
    {"identifier": "fs:allow-mkdir", "allow": [{"path": "$APPDATA/cutscenes"}, {"path": "$APPDATA/cutscenes/**"}]},
    {"identifier": "fs:allow-read-text-file", "allow": [{"path": "$APPDATA/cutscenes"}, {"path": "$APPDATA/cutscenes/**"}]},
    {"identifier": "fs:allow-write-text-file", "allow": [{"path": "$APPDATA/cutscenes"}, {"path": "$APPDATA/cutscenes/**"}]},
    {"identifier": "fs:allow-rename", "allow": [{"path": "$APPDATA/cutscenes"}, {"path": "$APPDATA/cutscenes/**"}]},
    "dialog:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
            "path": "**"
        }
      ]
    },
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-title",
    "core:window:allow-show"
  ]
}
